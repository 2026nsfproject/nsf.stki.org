---
const url = new URL(Astro.request.url);
const currentLang = url.searchParams.get("lang") === "en" ? "en" : "ja";

// 言語切り替え用のURL生成
const getLangUrl = (lang: string) => {
  const newUrl = new URL(Astro.request.url);
  newUrl.searchParams.set("lang", lang);
  return newUrl.pathname + newUrl.search;
};
---

<div class="flex items-center gap-1 bg-slate-100 p-1 rounded-xl text-xs font-bold border border-slate-200">
  <a
    href={getLangUrl("ja")}
    class={`px-2.5 py-1 rounded-lg transition-all ${
      currentLang === "ja"
        ? "bg-white text-slate-900 shadow-xs font-black"
        : "text-slate-500 hover:text-slate-900"
    }`}
  >
    JP
  </a>
  <a
    href={getLangUrl("en")}
    class={`px-2.5 py-1 rounded-lg transition-all ${
      currentLang === "en"
        ? "bg-white text-slate-900 shadow-xs font-black"
        : "text-slate-500 hover:text-slate-900"
    }`}
  >
    EN
  </a>
</div>
