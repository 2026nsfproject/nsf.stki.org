---
// src/components/EmaBoard.astro
const GAS_API_URL = import.meta.env.PUBLIC_GAS_API_URL || "";
const GOOGLE_FORM_ACTION_URL = import.meta.env.PUBLIC_GOOGLE_FORM_ACTION_URL || "";
---

<div class="py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- YouTube連動企画バナー -->
  <section class="bg-gradient-to-r from-amber-50/80 via-orange-50/90 to-amber-50/80 border border-orange-200/80 rounded-3xl p-6 sm:p-8 mb-10 text-center shadow-xs">
    <span class="inline-block bg-orange-600 text-white text-[11px] font-black px-3 py-1 rounded-full mb-3 tracking-wider uppercase">
      YouTube連動企画
    </span>
    <h2 class="text-xl sm:text-2xl font-black text-slate-900 mb-2.5">
      あなたの言葉が、動画になります。
    </h2>
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-2xl mx-auto mb-2 font-medium">
      名曲<strong class="text-orange-700">『愛は勝つ』（Piano Cover）</strong>に乗せて、全国から届いた応援メッセージ（絵馬）をYouTube動画として公開予定です。
    </p>
    <p class="text-[11px] text-slate-400 font-bold">
      ※投稿されたメッセージは、当掲示板に掲載されると同時に動画内でも大切に紹介させていただきます。
    </p>
  </section>

  <!-- 2カラムレイアウト（PC時）：フォーム ＆ 掲示板 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- 左側：オリジナルデザイン投稿フォーム (5カラム) -->
    <div class="lg:col-span-5 bg-white border border-slate-200/80 rounded-3xl p-6 sm:p-8 shadow-xs">
      
      <!-- フォームヘッダー -->
      <div class="border-b border-slate-100 pb-4 mb-6">
        <div class="flex items-center gap-2 mb-1">
          <span class="w-2 h-2 bg-orange-500 rounded-full animate-ping"></span>
          <h2 class="text-base sm:text-lg font-black text-slate-900">
            応援絵馬を奉納する
          </h2>
        </div>
        <p class="text-[11px] text-slate-400 font-medium">
          入力したメッセージは右側の掲示板に即時掲載されます。
        </p>
      </div>

      <!-- 送信用フォーム -->
      <form id="ema-submit-form" class="space-y-4">
        
        <!-- お名前 -->
        <div>
          <label for="input-name" class="block text-xs font-bold text-slate-700 mb-1.5 flex justify-between">
            <span>お名前 / ペンネーム <span class="text-rose-500">*</span></span>
            <span class="text-[10px] text-slate-400 font-normal">匿名可</span>
          </label>
          <input 
            type="text" 
            id="input-name" 
            name="name" 
            required 
            maxlength="20"
            placeholder="例: たろう / 熊本応援隊" 
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 transition"
          />
        </div>

        <!-- 地域 / 都道府県 -->
        <div>
          <label for="input-pref" class="block text-xs font-bold text-slate-700 mb-1.5 flex justify-between">
            <span>お住まいの地域 <span class="text-rose-500">*</span></span>
            <span class="text-[10px] text-slate-400 font-normal">都道府県など</span>
          </label>
          <input 
            type="text" 
            id="input-pref" 
            name="prefecture" 
            required 
            maxlength="12"
            placeholder="例: 東京都 / 熊本県" 
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 transition"
          />
        </div>

        <!-- 応援メッセージ本文 -->
        <div>
          <label for="input-msg" class="block text-xs font-bold text-slate-700 mb-1.5 flex justify-between items-center">
            <span>応援メッセージ <span class="text-rose-500">*</span></span>
            <span id="form-char-count" class="text-[10px] text-slate-400 font-mono">0 / 80文字</span>
          </label>
          <textarea 
            id="input-msg" 
            name="message" 
            rows="4" 
            required 
            maxlength="80"
            placeholder="熊本の皆様へ、心からの応援と一日も早い復興を願っています！" 
            class="w-full px-3.5 py-2.5 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:bg-white focus:outline-none focus:ring-2 focus:ring-orange-500/30 focus:border-orange-500 transition resize-none leading-relaxed"
          ></textarea>
        </div>

        <!-- 送信ボタン -->
        <div class="pt-2">
          <button 
            type="submit" 
            id="form-submit-btn"
            class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-black py-3 px-5 rounded-xl shadow-xs transition-all flex items-center justify-center gap-2 cursor-pointer active:scale-[0.98]"
          >
            <span>絵馬を掲示板へ奉納する</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </button>
        </div>

        <!-- 送信完了・エラーメッセージ枠 -->
        <div id="form-status" class="hidden text-center text-xs font-bold py-2 rounded-lg"></div>

      </form>
    </div>

    <!-- 右側：絵馬掲示板表示エリア (7カラム) -->
    <div class="lg:col-span-7 bg-white border border-slate-200/80 rounded-3xl p-6 sm:p-8 shadow-xs flex flex-col justify-between min-h-[580px]">
      <div>
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900">みんなの応援絵馬</h2>
            <p class="text-[11px] text-slate-400 font-bold mt-0.5">全国から寄せられた温かい言葉</p>
          </div>
          <button 
            id="refresh-btn" 
            class="bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-xs font-bold px-3.5 py-2 rounded-xl transition-all shadow-xs active:scale-95 flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            更新
          </button>
        </div>

        <!-- 絵馬カードグリッド -->
        <div id="ema-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-api={GAS_API_URL}>
          <p class="col-span-full text-center py-16 text-slate-400 text-xs font-bold animate-pulse">
            絵馬を読み込み中…
          </p>
        </div>
      </div>

      <!-- ページ切り替えコントロール -->
      <div id="pagination-controls" class="flex items-center justify-between pt-6 mt-6 border-t border-slate-100 hidden">
        <button 
          id="prev-page-btn" 
          class="bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-xs font-bold px-3.5 py-2 rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed"
        >
          ← 前の6件
        </button>
        <span id="page-info" class="text-xs font-bold text-slate-400 font-mono"></span>
        <button 
          id="next-page-btn" 
          class="bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-xs font-bold px-3.5 py-2 rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed"
        >
          次の6件 →
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  interface EmaItem {
    id: number;
    name?: string;
    message?: string;
    prefecture?: string;
    likes?: number;
  }

  let allMessages: EmaItem[] = [];
  let currentPage = 1;
  const ITEMS_PER_PAGE = 6;

  const NG_WORDS = [
    "http://", "https://", "死ね", "殺す", "バカ", "馬鹿", "アホ", "タコ"
  ];

  function filterValidMessages(data: any[]): EmaItem[] {
    if (!Array.isArray(data)) return [];
    const seenMessages = new Set<string>();

    return data.filter((item) => {
      const msg = (item.message || "").trim();
      const name = (item.name || "").trim();

      if (!msg || msg.length > 200) return false;

      const isInvalid = NG_WORDS.some(
        (word) => msg.includes(word) || name.includes(word)
      );
      if (isInvalid) return false;

      if (seenMessages.has(msg)) return false;
      seenMessages.add(msg);

      return true;
    });
  }

  function getLikedIds(): number[] {
    try {
      return JSON.parse(localStorage.getItem("liked_ema_ids") || "[]");
    } catch {
      return [];
    }
  }

  function saveLikedId(id: number) {
    const ids = getLikedIds();
    if (!ids.includes(id)) {
      ids.push(id);
      localStorage.setItem("liked_ema_ids", JSON.stringify(ids));
    }
  }

  async function loadEmaMessages() {
    const container = document.getElementById("ema-container");
    if (!container) return;

    const apiUrl = container.getAttribute("data-api");
    if (!apiUrl) {
      container.innerHTML = '<p class="col-span-full text-center py-8 text-amber-600 text-xs font-bold bg-amber-50 rounded-xl">.env に PUBLIC_GAS_API_URL を設定してください。</p>';
      return;
    }

    try {
      const response = await fetch(apiUrl);
      const data = await response.json();
      const filtered = filterValidMessages(data);
      allMessages = filtered.reverse();
      currentPage = 1;
      renderPage();
    } catch (error) {
      console.error("エラー:", error);
      container.innerHTML = '<p class="col-span-full text-center py-8 text-red-500 text-xs font-bold">絵馬の読み込みに失敗しました。</p>';
    }
  }

  function renderPage() {
    const container = document.getElementById("ema-container");
    const controls = document.getElementById("pagination-controls");
    const prevBtn = document.getElementById("prev-page-btn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("next-page-btn") as HTMLButtonElement | null;
    const pageInfo = document.getElementById("page-info");

    if (!container) return;
    container.innerHTML = "";

    if (!allMessages || allMessages.length === 0) {
      container.innerHTML = '<p class="col-span-full text-center py-12 text-slate-400 text-xs font-bold">まだ絵馬がありません。最初の投稿をお願いします！</p>';
      if (controls) controls.classList.add("hidden");
      return;
    }

    const totalPages = Math.ceil(allMessages.length / ITEMS_PER_PAGE);
    const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
    const currentMessages = allMessages.slice(startIdx, startIdx + ITEMS_PER_PAGE);
    const likedIds = getLikedIds();

    currentMessages.forEach((item) => {
      const emaCard = document.createElement("div");
      emaCard.className = "bg-amber-50/70 border border-amber-800/30 rounded-2xl p-4 sm:p-5 relative shadow-xs hover:shadow-sm transition-all flex flex-col justify-between clip-ema h-[250px] w-full";
      
      const isLiked = likedIds.includes(item.id);

      emaCard.innerHTML = `
        <div class="text-center text-[9px] font-black text-amber-800/60 tracking-widest pb-1 border-b border-amber-800/15 shrink-0">
          奉 納
        </div>
        
        <div class="flex-1 my-2 px-1 w-full overflow-y-auto block">
          <p class="text-slate-800 text-xs sm:text-[13px] font-bold leading-relaxed text-center w-full whitespace-pre-wrap break-words min-h-full flex items-center justify-center">
            ${escapeHtml(item.message || "")}
          </p>
        </div>

        <div class="pt-2 border-t border-dashed border-amber-800/20 flex justify-between items-center text-xs text-amber-900/70 font-bold shrink-0">
          <div class="flex items-center gap-1.5 truncate max-w-[130px]">
            <span class="truncate">${escapeHtml(item.name || "匿名")}</span>
            ${item.prefecture ? `<span class="text-[9px] bg-amber-200/60 text-amber-900 px-1.5 py-0.5 rounded shrink-0">${escapeHtml(item.prefecture)}</span>` : ''}
          </div>

          <button 
            type="button" 
            class="like-btn flex items-center gap-1 px-2 py-0.5 rounded-full text-xs transition-all active:scale-90 ${
              isLiked 
                ? 'bg-rose-100 text-rose-600 font-extrabold cursor-default' 
                : 'bg-amber-100/80 hover:bg-rose-100 hover:text-rose-600 text-amber-900/80 font-bold'
            }"
            data-id="${item.id}"
            ${isLiked ? "disabled" : ""}
          >
            <svg class="w-3.5 h-3.5 ${isLiked ? 'fill-rose-500 stroke-rose-500' : 'fill-none stroke-current'}" viewBox="0 0 24 24" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            <span class="like-count font-mono">${item.likes || 0}</span>
          </button>
        </div>
      `;
      container.appendChild(emaCard);
    });

    bindLikeEvents();

    if (controls) {
      if (totalPages > 1) {
        controls.classList.remove("hidden");
        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        if (pageInfo) pageInfo.textContent = `${currentPage} / ${totalPages} ページ`;
      } else {
        controls.classList.add("hidden");
      }
    }
  }

  function bindLikeEvents() {
    const container = document.getElementById("ema-container");
    if (!container) return;
    const apiUrl = container.getAttribute("data-api");
    if (!apiUrl) return;

    const likeButtons = container.querySelectorAll<HTMLButtonElement>(".like-btn");
    likeButtons.forEach((btn) => {
      btn.onclick = async (e) => {
        e.preventDefault();
        const targetBtn = e.currentTarget as HTMLButtonElement;
        const idStr = targetBtn.getAttribute("data-id");
        if (!idStr) return;

        const id = Number(idStr);
        if (getLikedIds().includes(id)) return;

        targetBtn.disabled = true;
        const countEl = targetBtn.querySelector(".like-count");
        const currentCount = Number(countEl?.textContent || 0);

        if (countEl) countEl.textContent = String(currentCount + 1);
        targetBtn.classList.remove("bg-amber-100/80", "text-amber-900/80");
        targetBtn.classList.add("bg-rose-100", "text-rose-600", "font-extrabold");
        const svg = targetBtn.querySelector("svg");
        if (svg) {
          svg.classList.remove("fill-none", "stroke-current");
          svg.classList.add("fill-rose-500", "stroke-rose-500");
        }

        saveLikedId(id);

        try {
          const res = await fetch(apiUrl, {
            method: "POST",
            headers: { "Content-Type": "text/plain" },
            body: JSON.stringify({ id }),
          });
          const result = await res.json();
          if (result.success && countEl) {
            countEl.textContent = String(result.likes);
            const targetItem = allMessages.find((m) => m.id === id);
            if (targetItem) targetItem.likes = result.likes;
          }
        } catch (err) {
          console.error("いいね処理エラー:", err);
        }
      };
    });
  }

  function escapeHtml(str: string): string {
    return str.replace(/[&<>"']/g, (m) => {
      const map: Record<string, string> = {
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
      };
      return map[m] || m;
    });
  }

  // フォーム送信 & 文字数カウントのバインド
  function initForm() {
    const form = document.getElementById("ema-submit-form") as HTMLFormElement | null;
    const msgInput = document.getElementById("input-msg") as HTMLTextAreaElement | null;
    const charCount = document.getElementById("form-char-count");
    const statusBox = document.getElementById("form-status");
    const submitBtn = document.getElementById("form-submit-btn") as HTMLButtonElement | null;
    const container = document.getElementById("ema-container");
    const apiUrl = container?.getAttribute("data-api");

    if (msgInput && charCount) {
      msgInput.addEventListener("input", () => {
        charCount.textContent = `${msgInput.value.length} / 80文字`;
      });
    }

    if (form && apiUrl) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!submitBtn) return;

        submitBtn.disabled = true;
        submitBtn.classList.add("opacity-60");
        if (statusBox) {
          statusBox.classList.remove("hidden", "bg-emerald-50", "text-emerald-700", "bg-rose-50", "text-rose-700");
          statusBox.classList.add("bg-slate-50", "text-slate-600");
          statusBox.textContent = "絵馬を奉納中…";
        }

        const formData = new FormData(form);
        const payload = {
          name: formData.get("name"),
          prefecture: formData.get("prefecture"),
          message: formData.get("message"),
        };

        try {
          // Google Apps Script (GAS) への新規投稿POST
          await fetch(apiUrl, {
            method: "POST",
            headers: { "Content-Type": "text/plain" },
            body: JSON.stringify(payload),
          });

          if (statusBox) {
            statusBox.className = "text-center text-xs font-bold py-2 rounded-lg bg-emerald-50 text-emerald-700 block";
            statusBox.textContent = "✨ 応援絵馬を奉納しました！";
          }
          form.reset();
          if (charCount) charCount.textContent = "0 / 80文字";

          // 投稿後、自動で最新一覧を再読み込み
          setTimeout(() => {
            loadEmaMessages();
            if (statusBox) statusBox.classList.add("hidden");
          }, 2000);

        } catch (err) {
          console.error("送信エラー:", err);
          if (statusBox) {
            statusBox.className = "text-center text-xs font-bold py-2 rounded-lg bg-rose-50 text-rose-700 block";
            statusBox.textContent = "送信に失敗しました。もう一度お試しください。";
          }
        } finally {
          submitBtn.disabled = false;
          submitBtn.classList.remove("opacity-60");
        }
      });
    }
  }

  const initEmaBoard = () => {
    loadEmaMessages();
    initForm();

    const refreshBtn = document.getElementById("refresh-btn");
    const prevBtn = document.getElementById("prev-page-btn");
    const nextBtn = document.getElementById("next-page-btn");

    if (refreshBtn) refreshBtn.onclick = () => loadEmaMessages();
    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
        }
      };
    }
    if (nextBtn) {
      nextBtn.onclick = () => {
        const totalPages = Math.ceil(allMessages.length / ITEMS_PER_PAGE);
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
        }
      };
    }
  };

  initEmaBoard();
  document.addEventListener("astro:page-load", initEmaBoard);
</script>

<style>
  /* 絵馬の五角形カットアウト */
  .clip-ema {
    clip-path: polygon(12% 0%, 88% 0%, 100% 15%, 100% 100%, 0% 100%, 0% 15%);
    padding-top: 1.5rem;
  }
</style>
