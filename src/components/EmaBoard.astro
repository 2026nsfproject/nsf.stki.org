---
const GAS_API_URL = import.meta.env.PUBLIC_GAS_API_URL || "";
const GOOGLE_FORM_URL = import.meta.env.PUBLIC_GOOGLE_FORM_URL || "";
---

<div class="py-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  <!-- YouTube連動企画バナー -->
  <section class="bg-gradient-to-r from-amber-50 to-orange-50 border-2 border-orange-200 rounded-2xl p-6 sm:p-8 mb-10 text-center shadow-sm">
    <span class="inline-block bg-orange-600 text-white text-xs font-black px-3 py-1 rounded-full mb-3 tracking-wider">
      YouTube連動企画
    </span>
    <h2 class="text-xl sm:text-2xl font-black text-orange-950 mb-3">
      あなたの言葉が、動画になります。
    </h2>
    <p class="text-sm sm:text-base text-slate-700 leading-relaxed max-w-2xl mx-auto mb-2 font-medium">
      名曲<strong class="text-orange-700">『愛は勝つ』（Piano Cover）</strong>に乗せて、全国から届いた応援メッセージ（絵馬）をYouTube動画として公開予定です。
    </p>
    <p class="text-xs text-slate-500 font-bold">
      ※投稿されたメッセージは、当掲示板に掲載されると同時に動画内でも大切に紹介させていただきます。
    </p>
  </section>

  <!-- 2カラムレイアウト（PC時）：フォーム ＆ 掲示板 -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    
    <!-- 左側：Googleフォーム埋め込みエリア -->
    <div class="lg:col-span-5 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm h-fit">
      <h2 class="text-lg font-black text-slate-900 mb-1 flex items-center gap-2">
        <span class="w-2.5 h-2.5 bg-red-600 rounded-full inline-block"></span>
        絵馬を投稿する
      </h2>
      <p class="text-xs text-slate-500 mb-4 font-bold">※投稿されたメッセージは右側の掲示板へ即時反映されます。</p>
      
      {GOOGLE_FORM_URL ? (
        <iframe 
          src={GOOGLE_FORM_URL} 
          class="w-full h-[550px] border-0 rounded-xl bg-slate-50"
          loading="lazy">読み込んでいます…</iframe>
      ) : (
        <div class="p-8 text-center text-sm text-slate-400 bg-slate-50 rounded-xl">
          .envファイルに PUBLIC_GOOGLE_FORM_URL を設定してください。
        </div>
      )}
    </div>

    <!-- 右側：絵馬掲示板表示エリア -->
    <div class="lg:col-span-7 bg-white border border-slate-200 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
          <div>
            <h2 class="text-lg font-black text-slate-900">みんなの応援絵馬</h2>
            <p class="text-xs text-slate-500 font-bold mt-0.5">全国から寄せられたメッセージ</p>
          </div>
          <button 
            id="refresh-btn" 
            class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-black px-4 py-2 rounded-xl transition-all shadow-sm active:scale-95 flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
            更新する
          </button>
        </div>

        <!-- 絵馬カードグリッド -->
        <div id="ema-container" class="grid grid-cols-1 sm:grid-cols-2 gap-4" data-api={GAS_API_URL}>
          <p class="col-span-full text-center py-12 text-slate-400 text-sm font-bold animate-pulse">
            絵馬を読み込み中…
          </p>
        </div>
      </div>

      <!-- ページ切り替えコントロール -->
      <div id="pagination-controls" class="flex items-center justify-between pt-6 mt-6 border-t border-slate-100 hidden">
        <button 
          id="prev-page-btn" 
          class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-4 py-2 rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed"
        >
          ← 前の6件
        </button>
        <span id="page-info" class="text-xs font-bold text-slate-500"></span>
        <button 
          id="next-page-btn" 
          class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold px-4 py-2 rounded-xl transition-all disabled:opacity-30 disabled:cursor-not-allowed"
        >
          次の6件 →
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  let allMessages: Array<{ name?: string; message?: string; prefecture?: string }> = [];
  let currentPage = 1;
  const ITEMS_PER_PAGE = 6;

  async function loadEmaMessages() {
    const container = document.getElementById("ema-container");
    if (!container) return;

    const apiUrl = container.getAttribute("data-api");
    if (!apiUrl) {
      container.innerHTML = '<p class="col-span-full text-center py-8 text-amber-600 text-sm font-bold bg-amber-50 rounded-xl">.env に PUBLIC_GAS_API_URL を設定してください。</p>';
      return;
    }

    container.innerHTML = '<p class="col-span-full text-center py-12 text-slate-400 text-sm font-bold animate-pulse">最新の絵馬を読み込み中…</p>';

    try {
      const response = await fetch(apiUrl);
      const data = await response.json();
      
      allMessages = Array.isArray(data) ? [...data].reverse() : [];
      currentPage = 1;
      
      renderPage();
    } catch (error) {
      console.error("エラー:", error);
      container.innerHTML = '<p class="col-span-full text-center py-8 text-red-500 text-sm font-bold">絵馬の読み込みに失敗しました。</p>';
    }
  }

  function renderPage() {
    const container = document.getElementById("ema-container");
    const controls = document.getElementById("pagination-controls");
    const prevBtn = document.getElementById("prev-page-btn") as HTMLButtonElement | null;
    const nextBtn = document.getElementById("next-page-btn") as HTMLButtonElement | null;
    pageInfo = document.getElementById("page-info");

    if (!container) return;
    container.innerHTML = "";

    if (!allMessages || allMessages.length === 0) {
      container.innerHTML = '<p class="col-span-full text-center py-12 text-slate-400 text-sm font-bold">まだ絵馬がありません。最初の投稿をお願いします！</p>';
      if (controls) controls.classList.add("hidden");
      return;
    }

    const totalPages = Math.ceil(allMessages.length / ITEMS_PER_PAGE);
    const startIdx = (currentPage - 1) * ITEMS_PER_PAGE;
    const currentMessages = allMessages.slice(startIdx, startIdx + ITEMS_PER_PAGE);

    currentMessages.forEach((item) => {
      const emaCard = document.createElement("div");
      // h-[280px] に拡大し、[text-wrap:balance] を撤去。長文は内部スクロールで安全にカバー
      emaCard.className = "bg-amber-50/80 border-2 border-amber-800/40 rounded-2xl p-5 relative shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between clip-ema h-[280px] w-full";
      
      emaCard.innerHTML = `
        <!-- 奉納ヘッダー -->
        <div class="text-center text-[10px] font-black text-amber-800/60 tracking-widest pb-1.5 border-b border-amber-800/20 shrink-0">
          奉 納
        </div>
        
        <!-- メッセージ中央配置エリア -->
        <div class="flex-1 flex items-center justify-center my-2 px-1 w-full overflow-y-auto">
          <p class="text-slate-800 text-xs sm:text-sm font-bold leading-relaxed text-center w-full whitespace-pre-wrap break-words">
            ${escapeHtml(item.message || "")}
          </p>
        </div>

        <!-- フッター -->
        <div class="pt-2 border-t border-dashed border-amber-800/20 flex justify-between items-center text-xs text-amber-900/70 font-bold shrink-0">
          <span class="truncate max-w-[120px]">${escapeHtml(item.name || "匿名")}</span>
          ${item.prefecture ? `<span class="text-[11px] bg-amber-200/60 px-2 py-0.5 rounded-md shrink-0">${escapeHtml(item.prefecture)}</span>` : ''}
        </div>
      `;
      container.appendChild(emaCard);
    });

    if (controls) {
      if (totalPages > 1) {
        controls.classList.remove("hidden");
        if (prevBtn) prevBtn.disabled = currentPage === 1;
        if (nextBtn) nextBtn.disabled = currentPage >= totalPages;
        if (pageInfo) pageInfo.textContent = `${currentPage} / ${totalPages} ページ (${allMessages.length}件)`;
      } else {
        controls.classList.add("hidden");
      }
    }
  }

  function escapeHtml(str: string): string {
    return str.replace(/[&<>"']/g, (m) => {
      const map: Record<string, string> = {
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;'
      };
      return map[m] || m;
    });
  }

  let pageInfo: HTMLElement | null = null;
  const initEmaBoard = () => {
    loadEmaMessages();

    const refreshBtn = document.getElementById("refresh-btn");
    const prevBtn = document.getElementById("prev-page-btn");
    const nextBtn = document.getElementById("next-page-btn");

    if (refreshBtn) refreshBtn.onclick = () => loadEmaMessages();
    if (prevBtn) {
      prevBtn.onclick = () => {
        if (currentPage > 1) {
          currentPage--;
          renderPage();
        }
      };
    }
    if (nextBtn) {
      nextBtn.onclick = () => {
        const totalPages = Math.ceil(allMessages.length / ITEMS_PER_PAGE);
        if (currentPage < totalPages) {
          currentPage++;
          renderPage();
        }
      };
    }
  };

  initEmaBoard();
  document.addEventListener("astro:page-load", initEmaBoard);
</script>

<style>
  /* 絵馬の五角形カットアウト */
  .clip-ema {
    clip-path: polygon(12% 0%, 88% 0%, 100% 15%, 100% 100%, 0% 100%, 0% 15%);
    padding-top: 1.5rem;
  }
</style>
