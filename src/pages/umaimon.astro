---
// src/pages/umaimon.astro
import Layout from "../layouts/Layout.astro";
import { translations, type Lang } from "../lib/i18n";

// URLから言語パラメータを取得 (例: ?lang=en)
const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];
---

<Layout 
  title={currentLang === 'en' ? "Noto Umaimon Rediscovery Project | NSF PROJECTs" : "能登うまいもん再発見プロジェクト"} 
  activeKey="projects"
>
  <div class="max-w-5xl mx-auto px-4 py-16 space-y-16 w-full max-w-full box-border overflow-hidden">
    <!-- コンセプト -->
    <section class="max-w-4xl mx-auto bg-white p-8 md:p-10 rounded-3xl border border-slate-200 shadow-xs space-y-6 w-full box-border overflow-hidden">
      <p class="text-slate-800 text-sm md:text-base leading-relaxed font-medium italic border-l-4 border-orange-500 pl-4 py-1 break-words">
        {currentLang === 'en' ? (
          <>
            In Term 1, we visited Noto, interacting with local high school students and making traditional dishes to deeply learn about local culture. In Term 2, we expanded to Tokyo, hosting events to share Noto's charm. Now in Term 3, we plan to continue our energetic activities even further!
          </>
        ) : (
          <>
            1期では能登にいき、能登の高校生との交流や郷土料理を実際に作ることで、地域の伝統や食文化について深く学びました。続く2期では活動の場を東京へと広げ、より多くの人に魅力を届けるイベントを開催。3期目を迎えるこれからも、さらにパワーアップしてどんどん精力的に活動していく予定です！
          </>
        )}
      </p>
    </section>

    <!-- プロジェクト概要 & アプローチ -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-8 w-full box-border">
      
      <div class="lg:col-span-1 space-y-6 w-full box-border">
        <div class="bg-slate-900 text-white p-6 rounded-2xl border border-slate-800 shadow-sm space-y-5 box-border overflow-hidden">
          <div class="w-full flex justify-center bg-white p-3 rounded-xl border border-white/10">
            <img src="/p_logo/umaimon.png" alt="プロジェクト ロゴ" class="w-full h-auto max-h-32 object-contain rounded-lg">
          </div>

          <h3 class="font-black text-xs text-slate-400 uppercase tracking-widest border-b border-slate-800 pb-2">Project Overview</h3>
          <div class="space-y-3 w-full">
            <div>
              <p class="text-[10px] text-slate-500 font-bold uppercase">
                {currentLang === 'en' ? 'Project Leader' : 'プロジェクトリーダー'}
              </p>
              <p class="text-sm font-black text-slate-100 break-words">
                {currentLang === 'en' ? 'Kakeru Uehara' : '上原 かける'}
              </p>
            </div>
            <div>
              <p class="text-[10px] text-slate-500 font-bold uppercase">
                {currentLang === 'en' ? 'Start Date' : '開始時期'}
              </p>
              <p class="text-sm font-black text-slate-100 break-words">
                {currentLang === 'en' ? 'February 2025' : '2025年2月'}
              </p>
            </div>
            <div>
              <p class="text-[10px] text-slate-500 font-bold uppercase">
                {currentLang === 'en' ? 'Members' : '現在の参加人数'}
              </p>
              <p class="text-sm font-black text-slate-100 break-words">
                {currentLang === 'en' ? '10 Members' : '計 10 名'}
              </p>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-orange-800 to-amber-950 text-white p-6 rounded-2xl shadow-sm space-y-4 box-border overflow-hidden">
          <h4 class="font-black text-xs text-orange-300 uppercase tracking-widest">Our Approach</h4>
          <p class="text-xs text-slate-200 leading-relaxed font-medium break-words">
            {currentLang === 'en' 
              ? 'Support is not just about consumption, but connecting with Noto’s culture and becoming a fan. Placing food at the center fosters natural interactions across generations and regions.' 
              : 'ただ消費するだけの支援ではなく、能登の文化に深く触れ、ファンになってもらうこと。食を真ん中に置くことで、世代や地域を超えた自然な交流を生み出します。'}
          </p>
        </div>
      </div>

      <!-- 具体的な活動内容 -->
      <div class="lg:col-span-2 bg-white p-6 md:p-8 rounded-2xl border border-slate-200 shadow-xs flex flex-col justify-between space-y-6 w-full box-border overflow-hidden">
        <div class="space-y-6 w-full">
          <div class="flex items-center space-x-3 border-b border-slate-100 pb-3">
            <span class="w-2 h-6 bg-orange-600 rounded-full shrink-0"></span>
            <h3 class="text-lg font-black text-slate-950 break-words">
              {currentLang === 'en' ? 'Activities & Initiatives' : '具体的な活動内容'}
            </h3>
          </div>
          
          <p class="text-slate-600 text-xs md:text-sm leading-relaxed font-medium break-words">
            {currentLang === 'en' 
              ? 'We plan and operate events to share the appeal of local cuisine and regional ingredients with more people.' 
              : '郷土料理や地元の食材について、魅力をより多くの人に知ってもらうためのイベントを企画・運営しています。'}
          </p>

          <div class="bg-slate-50 p-5 rounded-xl border border-slate-200/60 space-y-2 box-border overflow-hidden">
            <div class="flex items-center space-x-2 flex-wrap gap-y-1">
              <span class="bg-orange-100 text-orange-700 font-black text-[10px] px-2 py-0.5 rounded shrink-0">
                {currentLang === 'en' ? 'Event Planning' : 'イベント企画・運営'}
              </span>
              <h4 class="font-black text-slate-950 text-sm break-words">
                {currentLang === 'en' ? 'Handmade Events from Scratch' : 'ゼロからの手作りイベント'}
              </h4>
            </div>
            <p class="text-slate-500 text-xs leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Members voluntarily handle the entire process from procuring Noto ingredients, securing event venues, to designing programs that engage all five senses.' 
                : '能登の食材手配をはじめ、開催に向けたイベントスペースの確保、五感で楽しんでもらうためのプログラム企画など、1から全てのプロセスをメンバー自身が自発的に行っています。'}
            </p>
          </div>

          <div class="bg-slate-50 p-5 rounded-xl border border-slate-200/60 space-y-2 box-border overflow-hidden">
            <div class="flex items-center space-x-2 flex-wrap gap-y-1">
              <span class="bg-amber-100 text-amber-700 font-black text-[10px] px-2 py-0.5 rounded shrink-0">
                {currentLang === 'en' ? 'Connections' : 'つながりの創出'}
              </span>
              <h4 class="font-black text-slate-950 text-sm break-words">
                {currentLang === 'en' ? 'Building Community Through Food' : '食を通じたコミュニティづくり'}
              </h4>
            </div>
            <p class="text-slate-500 text-xs leading-relaxed font-medium break-words">
              {currentLang === 'en' 
                ? 'Gathering around delicious food expands a warm community circle where participants and Noto producers can share thoughts on recovery.' 
                : '美味しい料理を囲むことで、参加者同士や能登の生産者の方々との間に、復興への想いを共有できる温かいコミュニティの輪を広げています。'}
            </p>
          </div>
        </div>

      </div>
    </section>

    <!-- 今後の活動予定 -->
    <section class="max-w-4xl mx-auto space-y-6 w-full box-border">
      <div class="text-center">
        <h3 class="text-xl font-black text-slate-950 break-words">
          {currentLang === 'en' ? 'Upcoming Schedule' : '今後の活動予定'}
        </h3>
        <div class="w-12 h-1 bg-orange-500 mx-auto mt-3 rounded-full"></div>
      </div>
      <div class="bg-white p-8 rounded-2xl border border-slate-200 shadow-xs text-center box-border overflow-hidden">
        <p class="text-slate-700 text-xs md:text-sm font-medium leading-relaxed max-w-2xl mx-auto break-words">
          {currentLang === 'en' 
            ? 'In the future, we hope to expand multifaceted events in Noto beyond local cuisine to let people experience the region’s charm in various ways.' 
            : '今後は能登現地でも、郷土料理の枠にとどまらず、地域の魅力を多角的に体感できるような複合的なイベントを展開していけたらと思っております。'}
        </p>
        <p class="text-slate-400 text-[10px] font-bold tracking-wider mt-4 uppercase">
          NEXT STEP... COMING SOON
        </p>
      </div>
    </section>
  </div>
</Layout>
