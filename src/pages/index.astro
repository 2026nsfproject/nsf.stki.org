<section id="news" class="py-10 bg-slate-50 border-b border-slate-200">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl md:text-2xl font-black text-slate-950 flex items-center gap-2">
        <span class="text-blue-600">NEWS</span> お知らせ
      </h2>
      <a href="/news" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition">
        一覧を見る ➔
      </a>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-xs divide-y divide-slate-100 overflow-hidden">
      {newsList.map((item) => (
        <a href={item.url} class="p-4 flex flex-col md:flex-row md:items-center space-y-2 md:space-y-0 md:space-x-6 hover:bg-slate-50 transition group">
          <div class="flex items-center space-x-3 shrink-0">
            <span class="text-xs font-semibold text-slate-400 font-mono">{item.date}</span>
            <span class={`text-[10px] font-bold px-2 py-0.5 rounded ${item.categoryColor}`}>
              {item.category}
            </span>
          </div>
          <h3 class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition line-clamp-1 flex-grow">
            {item.title}
          </h3>
        </a>
      ))}
    </div>
  </div>
</section>
