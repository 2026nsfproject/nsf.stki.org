---
// src/pages/news/[id].astro
import Layout from "../../layouts/Layout.astro";
import { getNewsDetail } from "../../lib/microcms";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

let article = null;
try {
  article = await getNewsDetail(id);
} catch (e) {
  console.error("記事の取得に失敗しました:", e);
  return Astro.redirect("/404");
}

// カテゴリに応じたバッジスタイルの判定
function getCategoryBadge(category: string) {
  switch (category) {
    case "activity":
      return { class: "bg-blue-100 text-blue-700", defaultText: "Note" };
    case "event":
      return { class: "bg-purple-100 text-purple-700", defaultText: "イベント" };
    case "press":
      return { class: "bg-emerald-100 text-emerald-700", defaultText: "リリース" };
    case "recruit":
      return { class: "bg-rose-100 text-rose-700", defaultText: "募集" };
    case "news":
    default:
      return { class: "bg-orange-100 text-orange-700", defaultText: "お知らせ" };
  }
}

const badge = getCategoryBadge(article.category);
---

<Layout title={`${article.title} | NSF PROJECTs`} activeKey="news">
  <main class="py-12 md:py-20 bg-slate-50 min-h-screen">
    <div class="max-w-3xl mx-auto px-4">
      
      <!-- パンくずリスト -->
      <nav class="flex items-center gap-2 text-xs font-bold text-slate-400 mb-6">
        <a href="/" class="hover:text-slate-700 transition">ホーム</a>
        <span>/</span>
        <a href="/#news" class="hover:text-slate-700 transition">お知らせ一覧</a>
        <span>/</span>
        <span class="text-slate-600 truncate max-w-[200px]">{article.title}</span>
      </nav>

      <article class="bg-white p-6 sm:p-10 md:p-12 rounded-2xl border border-slate-200/80 shadow-xs">
        <!-- 記事ヘッダー -->
        <header class="border-b border-slate-100 pb-6 mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xs font-mono font-bold text-slate-400">
              {article.publishedAt.slice(0, 10).replace(/-/g, ".")}
            </span>
            <span class={`text-[11px] font-bold px-2.5 py-0.5 rounded ${badge.class}`}>
              {article.badgeText || badge.defaultText}
            </span>
          </div>
          <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 leading-snug">
            {article.title}
          </h1>
        </header>

        <!-- 記事本文（microCMSのリッチエディタまたはテキストを表示） -->
        <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed whitespace-pre-wrap">
          {article.content ? (
            <div set:html={article.content} />
          ) : (
            <p class="text-slate-400 text-sm italic">本文が登録されていません。</p>
          )}
        </div>

        <!-- 記事下部フッター -->
        <footer class="mt-12 pt-6 border-t border-slate-100 flex justify-center">
          <a 
            href="/#news" 
            class="bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs px-6 py-3 rounded-xl transition shadow-xs"
          >
            ← お知らせ一覧に戻る
          </a>
        </footer>
      </article>

    </div>
  </main>
</Layout>
