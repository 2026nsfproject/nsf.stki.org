---
// src/pages/news/[id].astro
import Layout from "../../layouts/Layout.astro";
import { getNewsDetail } from "../../lib/microcms";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/404");
}

let article = null;
try {
  article = await getNewsDetail(id);
} catch (e) {
  console.error("記事の取得に失敗しました:", e);
  return Astro.redirect("/404");
}

function getCategoryBadge(category: string) {
  switch (category) {
    case "activity":
      return { class: "bg-blue-100 text-blue-700", defaultText: "Note" };
    case "event":
      return { class: "bg-purple-100 text-purple-700", defaultText: "イベント" };
    case "press":
      return { class: "bg-emerald-100 text-emerald-700", defaultText: "リリース" };
    case "recruit":
      return { class: "bg-rose-100 text-rose-700", defaultText: "募集" };
    case "news":
    default:
      return { class: "bg-orange-100 text-orange-700", defaultText: "お知らせ" };
  }
}

const badge = getCategoryBadge(article.category);
---

<Layout title={`${article.title} | NSF PROJECTs`} activeKey="news">
  <!-- 上下の余白（ヘッダー重なり防止） -->
  <main class="pt-20 sm:pt-24 md:pt-32 pb-12 sm:pb-16 md:pb-24 bg-slate-50 min-h-screen">
    
    <!-- 全体コンテナ幅を max-w-5xl に拡張（タイトルが1行に収まりやすくなります） -->
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      
      <!-- パンくずリスト -->
      <nav class="flex items-center gap-1.5 sm:gap-2 text-[11px] sm:text-xs font-bold text-slate-500 mb-4 sm:mb-6 flex-wrap">
        <a href="/" class="hover:text-slate-900 transition shrink-0">ホーム</a>
        <span class="text-slate-300 shrink-0">/</span>
        <a href="/#news" class="hover:text-slate-900 transition shrink-0">お知らせ一覧</a>
        <span class="text-slate-300 shrink-0">/</span>
        <span class="text-slate-700 truncate max-w-[120px] sm:max-w-xs md:max-w-none md:overflow-visible md:whitespace-normal">
          {article.title}
        </span>
      </nav>

      <!-- 記事カード -->
      <article class="bg-white p-5 sm:p-8 md:p-12 lg:p-14 rounded-2xl sm:rounded-3xl border border-slate-200/80 shadow-xs">
        
        <!-- 記事ヘッダー -->
        <header class="border-b border-slate-100 pb-5 sm:pb-7 mb-6 sm:mb-8">
          <div class="flex items-center gap-2.5 sm:gap-3 mb-3 sm:mb-4 flex-wrap">
            <span class="text-xs font-mono font-bold text-slate-400">
              {article.publishedAt.slice(0, 10).replace(/-/g, ".")}
            </span>
            <span class={`text-[10px] sm:text-[11px] font-bold px-2.5 py-0.5 rounded ${badge.class}`}>
              {article.badgeText || badge.defaultText}
            </span>
          </div>
          <!-- タイトル（PCで1行に収まりやすい文字サイズ＆引き締まった文字間） -->
          <h1 class="text-xl sm:text-2xl md:text-[25px] lg:text-[28px] font-black text-slate-900 leading-snug tracking-tight">
            {article.title}
          </h1>
        </header>

        <!-- 記事本文 -->
        <div class="news-content text-slate-800">
          {article.content ? (
            <div set:html={article.content} />
          ) : (
            <p class="text-slate-400 text-sm italic">本文が登録されていません。</p>
          )}
        </div>

        <!-- 記事下部フッター -->
        <footer class="mt-10 sm:mt-14 pt-6 sm:pt-8 border-t border-slate-100 flex justify-center">
          <a 
            href="/#news" 
            class="w-full sm:w-auto text-center bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs px-8 py-3.5 rounded-xl transition shadow-xs"
          >
            ← お知らせ一覧に戻る
          </a>
        </footer>

      </article>

    </div>
  </main>
</Layout>

<style is:global>
  /* -------------------------------------------
     ▼ レスポンシブ対応 タイポグラフィ & Note風スタイル
     ------------------------------------------- */
  .news-content {
    font-size: 15px;
    line-height: 1.85;
    letter-spacing: 0.015em;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  @media (min-width: 640px) {
    .news-content {
      font-size: 16.5px;
      line-height: 1.95;
    }
  }

  .news-content p {
    margin-bottom: 1.35rem;
  }
  @media (min-width: 640px) {
    .news-content p {
      margin-bottom: 1.65rem;
    }
  }

  /* 見出し */
  .news-content h2,
  .news-content h3 {
    font-weight: 800;
    color: #0f172a;
    line-height: 1.4;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .news-content h2 {
    font-size: 1.2rem;
  }
  .news-content h3 {
    font-size: 1.1rem;
  }
  @media (min-width: 640px) {
    .news-content h2 {
      font-size: 1.35rem;
      margin-top: 2.75rem;
      margin-bottom: 1rem;
    }
    .news-content h3 {
      font-size: 1.2rem;
      margin-top: 2.25rem;
      margin-bottom: 0.85rem;
    }
  }

  /* リスト */
  .news-content ul {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin-bottom: 1.35rem;
  }
  .news-content ol {
    list-style-type: decimal;
    padding-left: 1.25rem;
    margin-bottom: 1.35rem;
  }
  .news-content li {
    margin-bottom: 0.35rem;
  }

  /* 引用 */
  .news-content blockquote {
    border-left: 3px solid #cbd5e1;
    padding-left: 0.85rem;
    margin: 1.5rem 0;
    color: #475569;
  }

  /* 画像（レスポンシブ・アスペクト比維持） */
  .news-content img {
    border-radius: 6px;
    margin: 1.75rem auto 0.5rem auto;
    max-width: 100%;
    height: auto;
    display: block;
  }
  @media (min-width: 640px) {
    .news-content img {
      margin: 2.25rem auto 0.5rem auto;
    }
  }

  /* キャプション（画像直下のテキスト） */
  .news-content p:has(img) + p,
  .news-content figcaption {
    font-size: 0.75rem;
    color: #737373;
    text-align: center;
    margin-top: -0.25rem;
    margin-bottom: 1.75rem;
    line-height: 1.5;
  }
  @media (min-width: 640px) {
    .news-content p:has(img) + p,
    .news-content figcaption {
      font-size: 0.8rem;
      margin-bottom: 2.25rem;
    }
  }
</style>
