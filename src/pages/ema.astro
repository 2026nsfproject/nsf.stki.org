---
// src/pages/ema.astro
import Layout from '../layouts/Layout.astro';
import EmaBoard from '../components/EmaBoard.astro';
---

<Layout title="熊本 応援絵馬掲示板" activeKey="projects">
  <!-- ページヘッダー -->
  <div class="bg-slate-900 text-white py-12 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-800">
    <div class="max-w-4xl mx-auto">
      <span class="text-blue-400 text-xs font-black tracking-widest uppercase mb-2 inline-block">
        Kumamoto Support
      </span>
      <h1 class="text-2xl sm:text-4xl font-black tracking-tight mb-4">
        応援絵馬掲示板
      </h1>
      <p class="text-slate-300 text-sm sm:text-base font-normal max-w-2xl mx-auto leading-relaxed">
        全国から寄せられたメッセージを「絵馬」にして現地へ届けます。
      </p>
    </div>
  </div>

  <!-- メインコンテンツ（絵馬ボード） -->
  <EmaBoard />

  <!-- ボトムCTA導線 -->
  <section class="bg-slate-100 border-t border-slate-200 py-12 px-4 text-center">
    <div class="max-w-3xl mx-auto">
      <h3 class="text-lg font-black text-slate-900 mb-2">NSF PROJECTs の取り組みについて</h3>
      <p class="text-slate-600 text-sm font-medium mb-6">
        地域創生や防災・減災に関する全国の学生メンバーによる最新の活動は、公式Noteや各プロジェクトページからご覧いただけます。
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a 
          href="/projects" 
          class="bg-blue-600 hover:bg-blue-700 text-white text-sm font-black px-6 py-3 rounded-xl transition-all shadow-sm"
        >
          プロジェクト一覧を見る
        </a>
        <a 
          href="/contact" 
          class="bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 text-sm font-black px-6 py-3 rounded-xl transition-all"
        >
          お問い合わせ
        </a>
      </div>
    </div>
  </section>
</Layout>
