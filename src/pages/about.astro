---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";

// 幹部メンバーの定義
const executives = [
  {
    role: "副代表",
    name: "陈 宥銘",
    message: "僕は大抵インスタ用の投稿画像とかこのような広報資料を作成してる人です。ヨルシカとギターが好きです。",
    img: "/p_logo/chin.jpg",
    style: "object-cover"
  },
  {
    role: "副代表",
    name: "神田 ふう",
    message: "災害を自分事に。熊本地震が発生し、他の場所でも地震が起こっている今、防災の大切さを幅広い世代の方々に知っていただけるように頑張って活動します。少しでも防災に興味をもってもらえたら嬉しいです。",
    img: "/p_logo/kanda.jpg",
    style: "object-cover"
  },
  {
    role: "副代表",
    name: "氏名が入ります",
    message: "組織の基盤を支え、メンバーが輝ける環境をつくります。",
    img: "/p_logo/exec3.png",
    style: "object-cover"
  },
  {
    role: "全体会議議長",
    name: "高江洲 義心",
    message: "皆さんのためになる学びの場や楽しめるイベントを外部から講師を招いたりして企画していきます。よろしくお願いします！",
    img: "/p_logo/takaesu.JPG",
    // 遠めの写真なので、顔周りに2倍ズームして表示位置を上に調整
    style: "object-cover scale-[1.8] origin-[50%_35%]" 
  },
  {
    role: "全体会議副議長",
    name: "氏名が入ります",
    message: "議長を支え、会議体のスムーズな運営と対話を促進します。",
    img: "/p_logo/exec5.png",
    style: "object-cover"
  },
  {
    role: "PL会議議長",
    name: "金田 大和",
    message: "高校2年生です。私はメンバー全員が挑戦を続けられるように頑張ってます。話すことが好きなので話かけてください♪",
    img: "/p_logo/kaneda.jpg",
    style: "object-cover"
  },
];
---

<Layout title="ABOUT - わたしたちについて" activeKey="about">
  <div class="py-10 md:py-16 max-w-5xl mx-auto px-4 space-y-12 md:space-y-16">
    
    <section class="text-center space-y-4 md:space-y-6">
      <span class="text-xs font-bold text-blue-600 tracking-widest block uppercase">OUR GOAL</span>
      <h2 class="text-2xl md:text-4xl font-black text-slate-950">震災前の当たり前を取り戻す。</h2>
      <p class="text-slate-600 text-sm md:text-base leading-relaxed max-w-2xl mx-auto font-medium">
        全国500名以上の中高生が手を取り合い、被災地と同じ目線に立った支援と防災アクションを展開しています。
      </p>
    </section>

    <section class="bg-white p-6 md:p-10 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center md:items-start gap-6 md:gap-10">
      <div class="w-full sm:w-80 md:w-96 aspect-[3/4] rounded-2xl overflow-hidden bg-slate-100 shrink-0 relative shadow-inner">
        <img 
          src="/p_logo/representative.png" 
          alt="NSF 代表 高野 怜生" 
          class="w-full h-full object-cover z-10 relative"
          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
        />
        <div class="hidden absolute inset-0 flex-col items-center justify-center p-4 text-center space-y-2">
          <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
          </svg>
          <span class="text-xs font-bold text-slate-400">NSF 6期代表 高野 怜生</span>
        </div>
      </div>
      
      <div class="flex flex-col justify-start space-y-5 w-full min-w-0">
        <div>
          <h3 class="text-2xl md:text-3xl font-black text-slate-950">代表メッセージ</h3>
          <p class="text-xs font-bold text-slate-400 block tracking-wider uppercase mt-1">Message from the Leader</p>
        </div>
        
        <div class="border-l-4 border-red-700 pl-3 md:pl-4 py-0.5 w-full overflow-hidden">
          <p class="font-black text-red-700 whitespace-nowrap text-one-line tracking-tight">
            ― 中高生の発想で、防災の『あたりまえ』を塗り替える ―
          </p>
        </div>
        
        <div class="text-slate-700 text-sm md:text-base leading-relaxed space-y-3 font-medium tracking-wide">
          <p>NSFは、中高生の発想力と行動力で、防災・復興の未来に向き合ってきました。</p>
          <p>災害を“遠い出来事”で終わらせず、一人ひとりが考え、備え、動ける社会をつくること。</p>
          <p>その小さな行動の積み重ねが、誰かの命を守る力になると信じています。</p>
          <p>これからも、一人ひとりが挑戦できる場所として、NSFをさらに前へ進めていきます。</p>
        </div>
        
        <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4">
          <span class="text-xs md:text-sm font-bold text-slate-500">NSF PROJECTs 6期代表</span>
          <span class="text-lg md:text-2xl font-black text-slate-900 tracking-wider">高野 怜生</span>
        </div>
      </div>
    </section>

    <section class="space-y-6 md:space-y-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div class="flex items-center space-x-3">
          <span class="w-8 md:w-10 h-1 bg-blue-600 inline-block rounded-full"></span>
          <h2 class="text-xl md:text-2xl font-black text-slate-950">幹部メンバー紹介</h2>
        </div>
        <span class="text-xs font-bold text-slate-400">全国500名超のメンバーを牽引</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
        {executives.map((member) => (
          <div class="bg-white p-6 md:p-8 rounded-3xl border border-slate-200 shadow-xs flex flex-col items-center text-center space-y-4">
            
            <div class="w-32 h-32 md:w-40 md:h-40 rounded-2xl bg-slate-100 overflow-hidden border border-slate-200 shrink-0 relative shadow-xs">
              <img 
                src={member.img} 
                alt={member.name} 
                class={`w-full h-full z-10 relative ${member.style}`}
                onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
              />
              <svg class="w-12 h-12 hidden absolute inset-0 m-auto text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
              </svg>
            </div>
            
            <div class="space-y-1.5">
              <span class="text-[11px] font-black bg-blue-50 text-blue-600 px-3 py-0.5 rounded-full uppercase tracking-widest inline-block">
                {member.role}
              </span>
              <h4 class="text-base md:text-lg font-black text-slate-900 pt-1">{member.name}</h4>
            </div>
            <p class="text-xs md:text-sm text-slate-600 leading-relaxed font-medium italic">
              「{member.message}」
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-8 md:space-y-10">
      <div class="flex items-center space-x-3">
        <span class="w-8 md:w-10 h-1 bg-blue-600 inline-block rounded-full"></span>
        <h2 class="text-xl md:text-2xl font-black text-slate-950">応援メッセージ
