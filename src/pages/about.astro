---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";

// 幹部メンバーの定義
const executives = [
  {
    role: "副代表",
    name: "氏名が入ります",
    message: "能登の未来を拓くため、全国の仲間と全力で併走します。",
    img: "http://googleusercontent.com/image_collection/image_retrieval/3045111405822961314" 
  },
  {
    role: "副代表",
    name: "氏名が入ります",
    message: "学生だからこそできる、新しい支援のカタチを追求します。",
    img: "http://googleusercontent.com/image_collection/image_retrieval/7171694554527554784"
  },
  {
    role: "事務局長",
    name: "氏名が入ります",
    message: "組織の基盤を支え、メンバーが輝ける環境をつくります。",
    img: "http://googleusercontent.com/image_collection/image_retrieval/11924484171016903004"
  },
  {
    role: "プロジェクト統括",
    name: "氏名が入ります",
    message: "各プロジェクトの熱量を最大化し、確かな成果へ繋げます。",
    img: "http://googleusercontent.com/image_collection/image_retrieval/6938666226078703677"
  },
  {
    role: "広報統括",
    name: "氏名が入ります",
    message: "能登の「今」と私たちの想いを、正しく、広く届けます。",
    img: "http://googleusercontent.com/image_collection/image_retrieval/9370199341546119686"
  },
];
---

<Layout title="ABOUT - わたしたちについて" activeKey="about">
  <div class="py-16 max-w-5xl mx-auto px-4 space-y-24">
    
    <section class="space-y-12">
      <div class="text-center space-y-4">
        <span class="text-xs font-bold text-blue-600 tracking-[0.2em] block uppercase">MESSAGE</span>
        <h2 class="text-3xl md:text-4xl font-black text-slate-950">代表あいさつ</h2>
      </div>

      <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-xl shadow-slate-200/50 overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <div class="w-full lg:w-2/5 h-[400px] lg:h-auto bg-slate-100 relative">
            <img 
              src="http://googleusercontent.com/image_collection/image_retrieval/1522670768217602773" 
              alt="NSF 代表 高野 怜生" 
              class="w-full h-full object-cover absolute inset-0"
            />
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-900/60 to-transparent p-8 lg:hidden">
                <p class="text-white text-xs font-bold opacity-80">NSF PROJECTs 第6期代表</p>
                <h3 class="text-white text-2xl font-black">高野 怜生</h3>
            </div>
          </div>

          <div class="w-full lg:w-3/5 p-8 md:p-12 space-y-8 flex flex-col justify-center">
            <div class="space-y-4">
              <p class="text-[10px] font-bold text-red-700 tracking-widest uppercase border-b border-red-100 w-fit pb-1">Leader's Vision</p>
              <h3 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 leading-[1.4] tracking-tight break-keep">
                <span class="inline-block">― 中高生の発想で、</span><br class="sm:hidden" />
                <span class="inline-block">防災の『あたりまえ』を</span><br class="hidden sm:inline" />
                <span class="inline-block">塗り替える ―</span>
              </h3>
            </div>

            <div class="space-y-4 text-slate-600 text-sm md:text-base leading-relaxed font-medium">
              <p>NSFは、中高生の発想力と行動力で、防災・復興の未来に向き合ってきました。</p>
              <p>災害を“遠い出来事”で終わらせず、一人ひとりが考え、備え、動ける社会をつくること。その小さな行動の積み重ねが、誰かの命を守る力になると信じています。</p>
              <p>これからも、一人ひとりが挑戦できる場所として、NSFをさらに前へ進めていきます。</p>
            </div>

            <div class="pt-8 border-t border-slate-100 flex items-end justify-between">
              <div class="hidden lg:block">
                <p class="text-xs font-bold text-slate-400">NSF PROJECTs 第6期代表</p>
                <p class="text-2xl font-black text-slate-900 tracking-tighter mt-1">高野 怜生 <span class="text-xs font-medium text-slate-400 ml-2">Leo Takano</span></p>
              </div>
              <div class="w-16 h-16 bg-slate-50 rounded-xl flex items-center justify-center border border-slate-100">
                <span class="text-slate-300 font-black text-xl">NSF</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-12 bg-slate-50/70 py-16 -mx-4 px-4 md:rounded-[3rem] border border-slate-100">
      <div class="text-center space-y-4">
        <span class="text-xs font-bold text-blue-600 tracking-[0.2em] block uppercase">EXECUTIVES</span>
        <h2 class="text-2xl md:text-3xl font-black text-slate-950">幹部メンバー紹介</h2>
        <p class="text-slate-500 text-sm font-medium">全国100名以上のメンバーを牽引する幹部メンバーです。</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {executives.map((member) => (
          <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-md transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center space-y-4">
            <div class="w-28 h-28 rounded-2xl bg-slate-100 overflow-hidden border-4 border-white shadow-md">
              <img 
                src={member.img} 
                alt={member.name} 
                class="w-full h-full object-cover"
              />
            </div>
            <div class="space-y-1">
              <span class="text-[10px] font-black bg-blue-50 text-blue-600 px-3 py-1 rounded-full uppercase tracking-widest">
                {member.role}
              </span>
              <h4 class="text-lg font-black text-slate-900 pt-1">{member.name}</h4>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed font-medium px-2 italic">
              「{member.message}」
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-12 pt-8">
      <div class="flex items-center space-x-3">
        <span class="w-12 h-1.5 bg-blue-600 inline-block rounded-full"></span>
        <h2 class="text-2xl md:text-3xl font-black text-slate-950 tracking-tight">応援メッセージ</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col space-y-8 relative">
          <div class="flex items-center space-x-5">
            <div class="w-24 h-24 bg-slate-50 rounded-full flex-shrink-0 overflow-hidden border-2 border-blue-100 shadow-sm">
              <img src="http://googleusercontent.com/image_collection/image_retrieval/807848441704356960" alt="坂井学氏" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-[10px] font-bold text-blue-600 tracking-[0.2em] uppercase mb-1">Supporter 01</p>
              <h3 class="font-black text-slate-950 text-lg md:text-xl italic leading-tight">坂井 学 <span class="text-xs font-normal text-slate-500 block">氏（前 内閣府特命担当大臣 防災）</span></h3>
            </div>
          </div>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed italic relative font-medium pl-6">
            <span class="text-5xl text-blue-100 absolute -top-4 -left-1 font-serif opacity-70">“</span>
            未来を見据え、防災について学び、考え、語り合おうとするみなさんの姿勢に、心から敬意を表します。防災は命と暮らしを守る大切な知恵であり、誰もが向き合うべきテーマです。自分らしいリーダーシップを育んでください。
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm flex flex-col space-y-8 relative">
          <div class="flex items-center space-x-5">
            <div class="w-24 h-24 bg-slate-50 rounded-full flex-shrink-0 overflow-hidden border-2 border-blue-100 shadow-sm">
              <img src="http://googleusercontent.com/image_collection/image_retrieval/11800134423737149230" alt="馳浩氏" class="w-full h-full object-cover">
            </div>
            <div>
              <p class="text-[10px] font-bold text-blue-600 tracking-[0.2em] uppercase mb-1">Supporter 02</p>
              <h3 class="font-black text-slate-950 text-lg md:text-xl italic leading-tight">馳 浩 <span class="text-xs font-normal text-slate-500 block">氏（石川県知事）</span></h3>
            </div>
          </div>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed italic relative font-medium pl-6">
            <span class="text-5xl text-blue-100 absolute -top-4 -left-1 font-serif opacity-70">“</span>
            募金活動や能登の魅力を全国に発信する活動は、能登の人々に勇気を与え、能登の復興の大きな後押しになるものと考えています。石川県知事として深く感謝申し上げます。
          </p>
        </div>
      </div>
      <p class="text-slate-400 text-center font-bold italic text-[10px]">※各氏の肩書はメッセージ提供当時の役職に基づいています。</p>
    </section>

    <section class="max-w-4xl mx-auto flex flex-col sm:flex-row items-center justify-center space-y-6 sm:space-y-0 sm:space-x-12 bg-blue-50/50 p-10 rounded-[3rem] border border-blue-100/50">
      <div class="w-32 h-32 flex-shrink-0">
        <img src="/IMG_1413.jpg" alt="えぬくま" class="w-full h-full object-contain">
      </div>
      <div class="text-center sm:text-left space-y-2">
        <h4 class="font-black text-blue-600 text-lg tracking-[0.2em] uppercase">Official Mascot</h4>
        <p class="text-slate-950 font-black text-xl mb-2">えぬくま <span class="text-sm font-medium text-slate-500 ml-1">Enukuma</span></p>
        <p class="text-slate-600 text-sm leading-relaxed max-w-md font-medium">
          ヘルメットと学生服を身にまとり、全国の中高生メンバーと一緒に、能登の未来を毎日応援しています！
        </p>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* 切れ味の良い改行のための追加CSS */
  .break-keep {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
</style>
