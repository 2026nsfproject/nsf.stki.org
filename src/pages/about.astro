---
// src/pages/about.astro
import Layout from "../layouts/Layout.astro";

// 幹部メンバーの定義 (画像がない状態でもアイコンで表示)
const executives = [
  {
    role: "副代表",
    name: "（氏名を記入してください）",
    message: "全国の中高生と繋がり、能登の復興を加速させます。",
    icon: "fa-solid fa-user-group"
  },
  {
    role: "副代表",
    name: "（氏名を記入してください）",
    message: "学生の視点から、新しい防災の形を提案していきます。",
    icon: "fa-solid fa-lightbulb"
  },
  {
    role: "事務局長",
    name: "（氏名を記入してください）",
    message: "組織を支え、持続可能なボランティアの基盤を築きます。",
    icon: "fa-solid fa-file-signature"
  },
  {
    role: "プロジェクト統括",
    name: "（氏名を記入してください）",
    message: "日本各地で実施するプロジェクトを強力にサポートします。",
    icon: "fa-solid fa-rocket"
  },
  {
    role: "広報統括",
    name: "（氏名を記入してください）",
    message: "能登の魅力と活動の熱量を、世界中へ発信します。",
    icon: "fa-solid fa-bullhorn"
  },
];
---

<Layout title="ABOUT - NSFについて" activeKey="about">
  <div class="py-16 max-w-5xl mx-auto px-4 space-y-24">
    
    <section class="space-y-12">
      <div class="text-center space-y-4">
        <span class="text-xs font-bold text-blue-600 tracking-[0.2em] block uppercase">MESSAGE FROM LEADER</span>
        <h2 class="text-3xl md:text-4xl font-black text-slate-950">代表あいさつ</h2>
      </div>

      <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-xl shadow-slate-200/40 overflow-hidden">
        <div class="flex flex-col lg:flex-row">
          <div class="w-full lg:w-2/5 h-[400px] lg:h-auto bg-slate-100 relative flex items-center justify-center">
            <img 
              src="/p_logo/representative.png" 
              alt="NSF 代表 高野 怜生" 
              class="w-full h-full object-cover absolute inset-0 z-10"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <div class="flex flex-col items-center justify-center p-8 text-center space-y-4">
              <div class="w-24 h-24 bg-blue-50 rounded-full flex items-center justify-center text-blue-300">
                <i class="fa-solid fa-user-tie text-5xl"></i>
              </div>
              <p class="text-xs font-bold text-slate-400">NSF 第6期代表<br>高野 怜生</p>
            </div>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-slate-900/60 to-transparent p-8 lg:hidden z-20">
                <p class="text-white text-xs font-bold opacity-80 uppercase tracking-widest">Representative</p>
                <h3 class="text-white text-2xl font-black">高野 怜生</h3>
            </div>
          </div>

          <div class="w-full lg:w-3/5 p-8 md:p-12 space-y-8 flex flex-col justify-center">
            <div class="space-y-4">
              <p class="text-[10px] font-bold text-red-700 tracking-[0.2em] uppercase border-b border-red-100 w-fit pb-1">Vision</p>
              <h3 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 leading-[1.4] tracking-tight break-keep">
                <span class="inline-block">― 中高生の発想で、</span><br class="sm:hidden" />
                <span class="inline-block">防災の『あたりまえ』を</span><br class="hidden sm:inline" />
                <span class="inline-block">塗り替える ―</span>
              </h3>
            </div>

            <div class="space-y-4 text-slate-600 text-sm md:text-base leading-relaxed font-medium">
              <p>NSFは、中高生の発想力と行動力で、防災・復興の未来に向き合ってきました。</p>
              <p>災害を“遠い出来事”で終わらせず、一人ひとりが考え、備え、動ける社会をつくること。その小さな行動の積み重ねが、誰かの命を守る力になると信じています。</p>
              <p>これからも、一人ひとりが挑戦できる場所として、NSFをさらに前へ進めていきます。</p>
            </div>

            <div class="pt-8 border-t border-slate-100 flex items-center justify-between">
              <div class="hidden lg:block">
                <p class="text-xs font-bold text-slate-400">NSF 第6期代表</p>
                <p class="text-2xl font-black text-slate-900 tracking-tighter mt-1">高野 怜生 <span class="text-xs font-normal text-slate-400 ml-2">Leo Takano</span></p>
              </div>
              <div class="w-14 h-14 bg-slate-50 rounded-2xl flex items-center justify-center border border-slate-100 opacity-50">
                <i class="fa-solid fa-landmark text-slate-300 text-xl"></i>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="space-y-12 bg-slate-50/70 py-20 -mx-4 px-4 md:rounded-[4rem] border-y border-slate-200/50 shadow-inner">
      <div class="text-center space-y-4">
        <span class="text-xs font-bold text-blue-600 tracking-[0.3em] block uppercase">EXECUTIVES</span>
        <h2 class="text-2xl md:text-3xl font-black text-slate-950 tracking-tight">NSF 幹部紹介</h2>
        <p class="text-slate-500 text-sm font-medium">全国100名以上のメンバーを代表する5名の幹部チームです。</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 max-w-5xl mx-auto px-2">
        {executives.map((member) => (
          <div class="bg-white p-8 rounded-[2rem] border border-slate-200 shadow-sm hover:shadow-lg transition-all duration-300 hover:-translate-y-1 flex flex-col items-center text-center space-y-5 group">
            <div class="w-24 h-24 rounded-3xl bg-slate-50 overflow-hidden border-2 border-slate-100 flex items-center justify-center relative shadow-inner">
               <img 
                src={`/p_logo/exec_${member.role}.png`} 
                alt={member.name} 
                class="w-full h-full object-cover absolute inset-0 z-10"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="flex items-center justify-center text-blue-200 group-hover:text-blue-400 transition-colors">
                <i class={`${member.icon} text-4xl`}></i>
              </div>
            </div>
            
            <div class="space-y-2">
              <span class="text-[9px] font-black bg-blue-50 text-blue-600 px-4 py-1.5 rounded-full uppercase tracking-[0.1em]">
                {member.role}
              </span>
              <h4 class="text-xl font-black text-slate-900 pt-1 tracking-tight">{member.name}</h4>
            </div>
            
            <p class="text-xs text-slate-500 leading-relaxed font-medium italic border-t border-slate-50 pt-4 px-2">
              「{member.message}」
            </p>
          </div>
        ))}
      </div>
    </section>

    <section class="space-y-12">
      <div class="flex items-center space-x-4">
        <span class="w-12 h-1.5 bg-blue-600 inline-block rounded-full"></span>
        <h2 class="text-2xl md:text-3xl font-black text-slate-950 tracking-tight">応援メッセージ</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm flex flex-col space-y-8 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-50/30 rounded-full -translate-y-1/2 translate-x-1/2 -z-10"></div>
          <div class="flex items-center space-x-5">
            <div class="w-20 h-20 bg-slate-100 rounded-full flex-shrink-0 overflow-hidden border-2 border-white shadow-sm relative flex items-center justify-center">
              <img src="/p_logo/sakai.jpg" alt="坂井学氏" class="w-full h-full object-cover z-10" onerror="this.style.display='none';">
              <i class="fa-solid fa-user text-slate-300 text-3xl"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-blue-600 tracking-[0.2em] uppercase mb-1">Supporter</p>
              <h3 class="font-black text-slate-950 text-lg italic leading-tight">坂井 学 <span class="text-xs font-normal text-slate-500 block mt-1">氏（前 内閣府特命担当大臣）</span></h3>
            </div>
          </div>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed italic relative font-medium pl-6">
            <span class="text-6xl text-blue-100 absolute -top-4 -left-2 font-serif opacity-70">“</span>
            未来を見据え、防災について学び、考え、語り合おうとするみなさんの姿勢に、心から敬意を表します。防災は命と暮らしを守る大切な知恵です。自分らしいリーダーシップを育んでください。
          </p>
        </div>

        <div class="bg-white p-8 rounded-[2.5rem] border border-slate-200 shadow-sm flex flex-col space-y-8 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-32 h-32 bg-red-50/30 rounded-full -translate-y-1/2 translate-x-1/2 -z-10"></div>
          <div class="flex items-center space-x-5">
            <div class="w-20 h-20 bg-slate-100 rounded-full flex-shrink-0 overflow-hidden border-2 border-white shadow-sm relative flex items-center justify-center">
              <img src="/p_logo/komaba.jpg" alt="馳浩氏" class="w-full h-full object-cover z-10" onerror="this.style.display='none';">
              <i class="fa-solid fa-user text-slate-300 text-3xl"></i>
            </div>
            <div>
              <p class="text-[10px] font-bold text-red-600 tracking-[0.2em] uppercase mb-1">Supporter</p>
              <h3 class="font-black text-slate-950 text-lg italic leading-tight">馳 浩 <span class="text-xs font-normal text-slate-500 block mt-1">氏（石川県知事）</span></h3>
            </div>
          </div>
          <p class="text-slate-600 text-sm md:text-base leading-relaxed italic relative font-medium pl-6">
            <span class="text-6xl text-red-100 absolute -top-4 -left-2 font-serif opacity-70">“</span>
            募金活動や能登の魅力を全国に発信する活動は、能登の人々に勇気を与え、能登の復興の大きな後押しになるものと考えています。石川県知事として深く感謝申し上げます。
          </p>
        </div>
      </div>
      <p class="text-slate-400 text-center font-bold italic text-[10px]">※各氏の肩書はメッセージ提供当時の役職に基づいています。</p>
    </section>

    <section class="max-w-4xl mx-auto bg-gradient-to-br from-blue-50/50 to-white p-10 rounded-[3.5rem] border border-blue-100/50 shadow-sm flex flex-col md:flex-row items-center gap-12">
      <div class="w-36 h-36 bg-white p-4 rounded-3xl shadow-sm border border-blue-50 shrink-0">
        <img src="/IMG_1413.jpg" alt="えぬくま" class="w-full h-full object-contain">
      </div>
      <div class="text-center md:text-left space-y-3">
        <div class="flex flex-col md:flex-row md:items-baseline gap-2">
            <h4 class="font-black text-blue-600 text-xl tracking-tight">えぬくま</h4>
            <span class="text-slate-400 font-bold text-xs uppercase tracking-widest">Enukuma / Official Mascot</span>
        </div>
        <p class="text-slate-600 text-sm leading-relaxed max-w-lg font-medium">
          ヘルメットと学生服を身にまとり、全国の中高生メンバーと一緒に、能登の未来を毎日応援しています！
        </p>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* 単語の途中で不自然に改行させない（切れ味を良くする） */
  .break-keep {
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  /* フォント読み込み（FontAwesome） */
  @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css');
</style>
