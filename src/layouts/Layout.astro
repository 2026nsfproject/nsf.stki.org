---
// src/layouts/Layout.astro
import "../global.css";
import Footer from "../components/Footer.astro";

export type NavKey = 'home' | 'about' | 'activities' | 'materials' | 'projects' | 'contact';

interface Props {
  title: string;
  activeKey?: NavKey;
  /** トップページのみtrueにし、ロゴアニメーション付きスプラッシュ画面を表示する */
  showSplash?: boolean;
}

const { title, activeKey, showSplash = false } = Astro.props;

// src/pages 直下の各プロジェクトファイルに対応したメニュー項目（パスをルート直下に修正）
const projectItems = [
  { label: 'すべてのプロジェクト', href: '/projects' },
  { label: 'mamoneruプロジェクト', href: '/mamoneru' },
  { label: 'まもみずプロジェクト', href: '/mamomizu' },
  { label: 'Bifrost', href: '/bifrost' },
  { label: '果てなき復興プロジェクト', href: '/hatenaki' },
  { label: 'survival academy', href: '/survival' },
  { label: '能登うまいもん再発見プロジェクト', href: '/umaimon' },
];

// メニュー定義
const navItems = [
  { key: 'home', label: 'HOME', href: '/' },
  { key: 'about', label: 'ABOUT', href: '/about' },
  { key: 'activities', label: 'ACTIVITIES', href: '/activities' },
  { key: 'materials', label: 'MATERIALS', href: '/materials' },
  { key: 'projects', label: 'PROJECTS', href: '/projects', hasSubmenu: true },
  { key: 'contact', label: 'CONTACT', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="U3N1SPErYZ6hcrPgWswh8WCyACwLkJXfE7c7QNofrBQ" />
  <meta name="description" content="NSF PROJECTsは、能登半島地震の被災地支援と学生の防災意識向上を目指し、全国の中高生が募金や情報発信を行うプロジェクトです。" />
  <title>{title} | NSF PROJECTs</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  {showSplash && (
    <style is:inline>
      body {
        visibility: hidden !important;
        opacity: 0 !important;
      }

      #splash-screen {
        visibility: visible !important;
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        right: 0 !important;
        bottom: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: radial-gradient(circle at center, #1e293b 0%, #0f172a 100%) !important;
        z-index: 999999 !important;
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        justify-content: center !important;
        opacity: 1 !important;
        transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1) !important;
      }

      .splash-content {
        text-align: center;
        visibility: visible !important;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      .splash-logo {
        height: 90px;
        width: auto;
        margin-bottom: 16px;
        visibility: visible !important;
        animation: logo-fade-in 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .splash-title {
        color: #ffffff;
        font-size: 18px;
        font-weight: 900;
        letter-spacing: 0.15em;
        margin-bottom: 24px;
        font-family: sans-serif;
        visibility: visible !important;
        animation: logo-fade-in 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      }

      .splash-progress-container {
        width: 180px;
        height: 2px;
        background-color: rgba(255, 255, 255, 0.08);
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 12px;
        visibility: visible !important;
      }

      .splash-progress-bar {
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
        transform: translateX(-100%);
        animation: progress-fill 1.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        visibility: visible !important;
      }

      .splash-text {
        color: rgba(255, 255, 255, 0.35);
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        font-family: sans-serif;
        visibility: visible !important;
        animation: text-pulse 1.5s ease-in-out infinite;
        padding-left: 0.4em;
      }

      @keyframes logo-fade-in {
        from { opacity: 0; transform: scale(0.96) translateY(8px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
      }

      @keyframes progress-fill {
        0% { transform: translateX(-100%); }
        50% { transform: translateX(0); }
        100% { transform: translateX(100%); }
      }

      @keyframes text-pulse {
        0%, 100% { opacity: 0.4; }
        50% { opacity: 0.8; }
      }
    </style>
  )}
</head>
<body class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen">

  {showSplash && (
    <div id="splash-screen">
      <div class="splash-content">
        <img src="/logo.jpg" alt="NSF ロゴ" class="splash-logo">
        <h2 class="splash-title">NSF PROJECTs</h2>
        <div class="splash-progress-container">
          <div class="splash-progress-bar"></div>
        </div>
        <p class="splash-text">Connecting</p>
      </div>
    </div>
  )}

  <!-- ヘッダーエリア -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2">
        <img src="/logo.jpg" alt="NSF ロゴ" class="h-8 w-auto" />
        <span class="font-bold text-slate-900 text-lg">NSF PROJECTs</span>
      </a>

      <!-- デスクトップナビゲーション -->
      <nav class="hidden md:flex items-center gap-6">
        {navItems.map((item) => (
          item.hasSubmenu ? (
            <div class="relative group py-5">
              <a
                href={item.href}
                class:list={[
                  "text-sm font-bold transition-colors hover:text-blue-600 flex items-center gap-1.5",
                  activeKey === item.key ? "text-blue-600 border-b-2 border-blue-600 pb-4" : "text-slate-600"
                ]}
              >
                {item.label}
                <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </a>

              <!-- PROJECTS サブメニュー -->
              <div class="absolute left-0 top-full hidden group-hover:block w-max min-w-[240px] max-w-xs bg-white border border-slate-200 rounded-2xl shadow-xl py-2 z-50">
                {projectItems.map((sub) => (
                  <a
                    href={sub.href}
                    class="block px-4 py-2.5 text-sm font-bold text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition-colors rounded-lg mx-1 whitespace-nowrap overflow-hidden text-ellipsis"
                  >
                    {sub.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                "text-sm font-bold transition-colors hover:text-blue-600 py-5 border-b-2",
                activeKey === item.key ? "text-blue-600 border-blue-600" : "text-slate-600 border-transparent"
              ]}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>

      <!-- モバイル用ハンバーガーボタン -->
      <button id="menu-btn" class="md:hidden p-2 text-slate-600 hover:text-slate-900" aria-label="メニューを開く">
        <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- モバイル用ドロワーメニュー -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-2 pb-4 shadow-lg">
      <nav class="flex flex-col gap-2">
        {navItems.map((item) => (
          item.hasSubmenu ? (
            <div class="flex flex-col">
              <a
                href={item.href}
                class:list={[
                  "px-3 py-2 rounded-md text-base font-bold transition-colors flex justify-between items-center",
                  activeKey === item.key ? "bg-blue-50 text-blue-600" : "text-slate-700 hover:bg-slate-50"
                ]}
              >
                {item.label}
              </a>
              <div class="pl-4 flex flex-col gap-1 my-1 border-l-2 border-slate-100 ml-3">
                {projectItems.map((sub) => (
                  <a href={sub.href} class="py-2 px-3 text-sm font-bold text-slate-600 hover:text-blue-600 hover:bg-slate-50 rounded-md transition-colors">
                    ・ {sub.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={[
                "px-3 py-2 rounded-md text-base font-bold transition-colors",
                activeKey === item.key ? "bg-blue-50 text-blue-600" : "text-slate-700 hover:bg-slate-50"
              ]}
            >
              {item.label}
            </a>
          )
        ))}
      </nav>
    </div>
  </header>

  <main class="flex-grow">
    <slot />
  </main>

  <Footer />

  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      if (mobileMenu?.classList.contains('hidden')) {
        menuIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>';
      } else {
        menuIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>';
      }
    });
  </script>

  {showSplash && (
    <script>
      const splash = document.getElementById('splash-screen');

      const hideSplashScreen = () => {
        if (splash && splash.style.opacity !== '0') {
          splash.style.opacity = '0';
          document.body.style.setProperty('visibility', 'visible', 'important');
          document.body.style.setProperty('opacity', '1', 'important');
          setTimeout(() => splash.remove(), 500);
        }
      };

      setTimeout(hideSplashScreen, 800);
    </script>
  )}
  <!-- Cloudflare Web Analytics --><script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "84212c2685e24ad0a29bfb18357342e8"}'></script><!-- End Cloudflare Web Analytics -->
</body>
</html>

<style is:global>
  body { font-family: 'Noto Sans JP', sans-serif; }
</style>
