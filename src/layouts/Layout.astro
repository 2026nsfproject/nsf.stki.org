---
// src/layouts/Layout.astro
import "../global.css";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import { translations, type Lang } from "../lib/i18n";

export type NavKey = 'home' | 'about' | 'apply' | 'materials' | 'projects' | 'contact';

interface Props {
  title: string;
  activeKey?: NavKey;
  showSplash?: boolean;
}

const { title, activeKey, showSplash = false } = Astro.props;

const url = new URL(Astro.request.url);
const currentLang: Lang = url.searchParams.get("lang") === "en" ? "en" : "ja";
const t = translations[currentLang];

const projectItems = [
  { label: currentLang === 'en' ? 'All Projects' : 'すべてのプロジェクト', href: '/projects' },
  { label: currentLang === 'en' ? 'Support Ema Board' : '応援絵馬掲示板', href: '/ema' },
  { label: currentLang === 'en' ? 'Mamoneru Project' : 'mamoneruプロジェクト', href: '/mamoneru' },
  { label: currentLang === 'en' ? 'Mamomizu Project' : 'まもみずプロジェクト', href: '/mamomizu' },
  { label: 'NSF Bifröst', href: '/bifrost' },
  { label: currentLang === 'en' ? 'Endless Reconstruction Project' : '果てなき復興プロジェクト', href: '/hatenaki' },
  { label: currentLang === 'en' ? 'Survival Academy' : 'survival academy', href: '/survival' },
  { label: currentLang === 'en' ? 'Noto Umaimon Rediscovery Project' : '能登うまいもん再発見プロジェクト', href: '/umaimon' },
  { label: currentLang === 'en' ? 'Kumamoto Umakamon Project' : '熊本うまかもんプロジェクト', href: '/kumamotoumakamon' },
];

const navItems = [
  { key: 'home', label: 'HOME', href: '/' },
  { key: 'about', label: 'ABOUT', href: '/about' },
  { key: 'apply', label: 'APPLY', href: '/apply' },
  { key: 'materials', label: 'MATERIALS', href: '/materials' },
  { key: 'projects', label: 'PROJECTS', href: '/projects', hasSubmenu: true },
  { key: 'contact', label: 'CONTACT', href: '/contact' },
];
---

<!DOCTYPE html>
<html lang={currentLang} class="scroll-smooth overflow-x-hidden">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title} | NSF PROJECTs</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
</head>
<body class="bg-slate-50 text-slate-900 antialiased flex flex-col min-h-screen w-full max-w-full overflow-x-hidden">

  <!-- ヘッダーエリア -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-50 w-full max-w-full box-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between w-full box-border">
      <a href="/" class="flex items-center gap-2 shrink-0">
        <img src="/logo.jpg" alt="NSF ロゴ" class="h-8 w-auto" />
        <span class="font-black text-slate-900 text-base sm:text-lg tracking-tight">NSF PROJECTs</span>
      </a>

      <!-- デスクトップナビゲーション -->
      <div class="hidden md:flex items-center gap-6">
        <nav class="flex items-center gap-6">
          {navItems.map((item) => (
            item.hasSubmenu ? (
              <div class="relative group py-5">
                <a href={item.href} class:list={["text-sm font-extrabold transition-colors hover:text-blue-600 flex items-center gap-1.5", activeKey === item.key ? "text-blue-600 border-b-2 border-blue-600 pb-4" : "text-slate-800"]}>
                  {item.label}
                  <svg class="w-3.5 h-3.5 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M19 9l-7 7-7-7"></path></svg>
                </a>
                <div class="absolute left-0 top-full hidden group-hover:block w-max min-w-[240px] max-w-xs bg-white border border-slate-200 rounded-2xl shadow-xl py-2 z-50">
                  {projectItems.map((sub) => (
                    <a href={sub.href} class="block px-4 py-2.5 text-sm font-extrabold text-slate-800 hover:bg-blue-50 hover:text-blue-600 transition-colors rounded-lg mx-1 whitespace-nowrap overflow-hidden text-ellipsis">
                      {sub.label}
                    </a>
                  ))}
                </div>
              </div>
            ) : (
              <a href={item.href} class:list={["text-sm font-extrabold transition-colors hover:text-blue-600 py-5 border-b-2", activeKey === item.key ? "text-blue-600 border-blue-600" : "text-slate-800 border-transparent"]}>
                {item.label}
              </a>
            )
          ))}
        </nav>
        <LanguageSwitcher />
      </div>

      <!-- モバイル用コントロール -->
      <div class="flex items-center gap-1.5 md:hidden shrink-0">
        <LanguageSwitcher />
        <button id="menu-btn" class="p-1.5 text-slate-800 hover:text-slate-900 focus:outline-none" aria-label="メニューを開く">
          <svg id="menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- モバイル用ドロワーメニュー -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-100 bg-white px-4 pt-2 pb-4 shadow-lg w-full box-border">
      <nav class="flex flex-col gap-2">
        {navItems.map((item) => (
          item.hasSubmenu ? (
            <div class="flex flex-col">
              <a href={item.href} class:list={["px-3 py-2 rounded-md text-base font-extrabold transition-colors flex justify-between items-center", activeKey === item.key ? "bg-blue-50 text-blue-600" : "text-slate-800 hover:bg-slate-50"]}>
                {item.label}
              </a>
              <div class="pl-4 flex flex-col gap-1 my-1 border-l-2 border-slate-200 ml-3">
                {projectItems.map((sub) => (
                  <a href={sub.href} class="py-2 px-3 text-sm font-bold text-slate-700 hover:text-blue-600 hover:bg-slate-50 rounded-md transition-colors">
                    ・ {sub.label}
                  </a>
                ))}
              </div>
            </div>
          ) : (
            <a href={item.href} class:list={["px-3 py-2 rounded-md text-base font-extrabold transition-colors", activeKey === item.key ? "bg-blue-50 text-blue-600" : "text-slate-800 hover:bg-slate-50"]}>
              {item.label}
            </a>
          )
        ))}
      </nav>
    </div>
  </header>

  <main class="flex-grow w-full max-w-full box-border overflow-x-hidden">
    <slot />
  </main>

  <footer class="bg-slate-900 text-white py-8 mt-auto border-t border-slate-800 w-full max-w-full box-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="font-normal text-sm text-slate-300 mb-2">Noto Student Fund PROJECTs</p>
      <p class="text-xs text-slate-500 font-normal">© NSF PROJECTs. All rights reserved.</p>
    </div>
  </footer>

  <script>
    const menuBtn = document.getElementById('menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    menuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
      if (mobileMenu?.classList.contains('hidden')) {
        menuIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>';
      } else {
        menuIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path>';
      }
    });

    document.addEventListener("DOMContentLoaded", () => {
      const urlParams = new URLSearchParams(window.location.search);
      const lang = urlParams.get("lang");
      if (!lang) return;

      document.querySelectorAll("a").forEach((a) => {
        const href = a.getAttribute("href");
        if (href && href.startsWith("/") && !href.includes("lang=")) {
          const separator = href.includes("?") ? "&" : "?";
          a.setAttribute("href", `${href}${separator}lang=${lang}`);
        }
      });
    });
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
  }
  html, body {
    max-width: 100vw;
    overflow-x: hidden;
  }
  body { 
    font-family: 'Noto Sans JP', -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "メイリオ", sans-serif;
    font-weight: 700;
    -webkit-font-smoothing: antialiased;
  }
</style>
